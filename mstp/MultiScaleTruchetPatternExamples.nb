              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "90"}], "}"}], "\[Degree]"}]}], "]"}], ",", 
            
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Polygon", "[", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"ArcPoints", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}], ",", ".5", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"180", ",", "270"}], "}"}], "\[Degree]"}]}], "]"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"FaceForm", "[", "None", "]"}], ",", 
