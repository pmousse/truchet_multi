  3.731575613303659*^9}},ExpressionUUID->"feae4ce9-16b9-4922-9881-\
67d7310e62cf"],

Cell[TextData[{
 "Generate in a separate notebook ",
 StyleBox["every",
  FontSlant->"Italic"],
 " combination of arc motif pairs on a checkerboard tiling.\nThis takes a \
while to run, but you can interrupt it at any time."
}], "Text",
 CellChangeTimes->{{3.731533593152813*^9, 3.7315336367356462`*^9}, {
   3.73157561953541*^9, 3.731575621847782*^9}, {3.731575736000539*^9, 
   3.7315757370293016`*^9}, {3.731576968922682*^9, 3.731576983376823*^9}, 
   3.7315770144480677`*^9, {3.734128748627347*^9, 
   3.7341287531783857`*^9}},ExpressionUUID->"ab9de05c-577a-4e9b-951d-\
87732715f35d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tiling", "=", 
      RowBox[{"CheckerboardTiling", "[", "8", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"tileNames", "=", 
         RowBox[{"SquareTileNames", "[", "]"}]}], ",", "tilePairs", ",", 
        "nb"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tilePairs", "=", 
        RowBox[{"Union", "[", 
         RowBox[{"Sort", " ", "/@", 
          RowBox[{"Tuples", "[", 
           RowBox[{"{", 
            RowBox[{"tileNames", ",", "tileNames"}], "}"}], "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"nb", "=", 
        RowBox[{"CreateDocument", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"NotebookWrite", "[", 
            RowBox[{"nb", ",", 
             RowBox[{"Cell", "[", 
              RowBox[{
               RowBox[{"StringJoin", "@@", 
                RowBox[{"Riffle", "[", 
                 RowBox[{"#", ",", "\"\<, \>\""}], "]"}]}], ",", 
               "\"\<Section\>\""}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"NotebookWrite", "[", 
            RowBox[{"nb", ",", 
             RowBox[{"Cell", "[", 
              RowBox[{
               RowBox[{"BoxData", "[", 
                RowBox[{"ToBoxes", "[", 
                 RowBox[{"ShowTiling", "[", 
                  RowBox[{"tiling", ",", "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{"RandomChoice", "[", 
                    RowBox[{"SquareArcTile", "/@", "#"}], "]"}], "}"}], ",", 
                   RowBox[{"ImageSize", "\[Rule]", "200"}]}], "]"}], "]"}], 
                "]"}], ",", "\"\<Output\>\""}], "]"}]}], "]"}]}], 
          "\[IndentingNewLine]", ")"}], "&"}], " ", "/@", " ", 
        "tilePairs"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.7266185008652287`*^9, 3.726618501847196*^9}, 
   3.726654802221739*^9, {3.7266634306575527`*^9, 3.726663450569004*^9}, {
