                    RowBox[{"{", 
                    RowBox[{"GrayLevel", "[", ".7", "]"}], "}"}], "]"}], ",", 
                   
                   RowBox[{"Rectangle", "[", "]"}]}], "}"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Thickness", "[", 
                    RowBox[{"2", " ", "th"}], "]"}], ",", 
                   RowBox[{"Line", "[", 
                    RowBox[{"ArcPoints", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "0"}], "}"}], ",", ".5", ",", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "90"}], "}"}], "\[Degree]"}]}], "]"}], 
                    "]"}], ",", "\[IndentingNewLine]", 
                   RowBox[{"Line", "[", 
                    RowBox[{"ArcPoints", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", "1"}], "}"}], ",", ".5", ",", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"180", ",", "270"}], "}"}], "\[Degree]"}]}], 
                    "]"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", "}"}], 
               ",", 
               RowBox[{"2", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "1"}], "}"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "2"}], ",", "3"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Translate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"EvenQ", "[", 
                   RowBox[{"x", "+", "y"}], "]"}], ",", "InvertMotif", ",", 
                  "Identity"}], "]"}], "@", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"or", "[", 
                   RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], ",", 
                  "\[IndentingNewLine]", "motif", ",", "\[IndentingNewLine]", 
                  
                  RowBox[{"Rotate", "[", 
                   RowBox[{
                    RowBox[{"InvertMotif", "@", "motif"}], ",", 
                    RowBox[{"90", "\[Degree]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{".5", ",", ".5"}], "}"}]}], "]"}]}], 
                 "\[IndentingNewLine]", "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "1", ",", "n"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
