           RowBox[{"Translate", "[", 
            RowBox[{
             RowBox[{"Scale", "[", 
              RowBox[{
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"FaceForm", "[", "None", "]"}], ",", 
