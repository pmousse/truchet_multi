       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "111", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"or", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"RandomChoice", "[", 
            RowBox[{"{", 
             RowBox[{"True", ",", "False"}], "}"}], "]"}], ",", 
